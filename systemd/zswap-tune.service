[Unit]
Description=Auto-tune zswap compressed pool size
Documentation=file:///home/vi/tune/crates/zswap-tune/README.md
After=swap.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zswap-tune
Restart=on-failure
RestartSec=5

# Runs as root: it must write to /sys/module/zswap/parameters/max_pool_percent
# (root-writable, mode 0644 root:root), so User= is intentionally unset.

# Output goes to the journal; the daemon logs every poll and every change.
StandardOutput=journal
StandardError=journal

# --- hardening: only directives that cannot interfere with /sys/module writes
# and cannot block a long-running root daemon.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/sys/module/zswap/parameters
# The daemon appends its recording history to /var/log/zswap-tune, which
# LogsDirectory creates and owns; ReadWritePaths admits it past ProtectSystem.
LogsDirectory=zswap-tune
ReadWritePaths=/var/log/zswap-tune
ProtectHome=read-only
PrivateTmp=true

# Deliberately NOT set (each of these can interfere with this daemon):
#   MemoryDenyWriteExecute  - unnecessary, can break the Rust stack guard
#   LockPersonality         - no benefit here
#   RestrictAddressFamilies - keep defaults so journald logging cannot break
#   ProtectKernelModules    - CAN block writes to /sys/module/... (the trap)
#   ProtectKernelTunables   - CAN block writes to /sys/module/... (the trap)

[Install]
WantedBy=multi-user.target
