[Unit]
Description=Animaksm Deduplicating Swap Proxy (experimental)
Documentation=https://github.com/animaios/animaksm
BindsTo=animaksm.service
After=animaksm.service

[Service]
Type=simple
ExecStart=/usr/local/bin/animaksm-swap-proxy run --store-path /var/lib/animaksm/pagestore.dat
ExecStopPost=-/usr/local/bin/animaksm-swap-proxy cleanup
Restart=no

# Security hardening
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_IPC_LOCK CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_IPC_LOCK CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/animaksm

# Self-hardening: memory, OOM, scheduling
MemoryDenyWriteExecute=yes
PrivateTmp=yes
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
IOchedulingClass=realtime
IOchedulingPriority=0
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
