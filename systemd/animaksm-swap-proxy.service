[Unit]
Description=Animaksm Deduplicating Swap Proxy (experimental)
Documentation=https://github.com/animaios/animaksm
BindsTo=animaksm.service
After=animaksm.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/swapoff -a
ExecStartPre=-/usr/bin/swapon -a
ExecStartPre=-/sbin/modprobe ublk_drv
ExecStartPre=-/usr/local/bin/animaksm-swap-proxy cleanup
ExecStart=/usr/local/bin/animaksm-swap-proxy run --store-path /var/lib/animaksm/pagestore.dat
ExecStopPost=-/usr/local/bin/animaksm-swap-proxy cleanup
Restart=on-failure
RestartSec=5s

# Security hardening
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_IPC_LOCK CAP_SYS_NICE CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_IPC_LOCK CAP_SYS_NICE CAP_SYS_RESOURCE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/animaksm

# Self-hardening: memory, OOM, scheduling
MemoryDenyWriteExecute=yes
PrivateTmp=yes
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
IOSchedulingClass=realtime
IOSchedulingPriority=0
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
